      "id": "b2f0c3e2-0008-4c1a-9b11-000000000008",
      "name": "Buscar lead",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        400,
        100
      ],
      "alwaysOutputData": true
