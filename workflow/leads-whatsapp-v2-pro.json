    {
      "parameters": {
        "jsCode": "// Normaliza o payload do WhatsApp Cloud API: 1 item por mensagem recebida.\n// Eventos sem 'messages' (entregue/lido) são descartados aqui.\nconst cfg = $('Configurações').first().json;\nconst out = [];\n\nfunction formatarTelefone(id) {\n  const d = String(id).replace(/\\D/g, '');\n  if (!d.startsWith('55') || d.length < 12) return '+' + d;\n  const ddd = d.slice(2, 4);\n  let num = d.slice(4);\n  // Celulares antigos chegam sem o 9 na frente; só ajusta a EXIBIÇÃO.\n  if (num.length === 8 && Number(num[0]) >= 6) num = '9' + num;\n  return num.length === 9\n    ? `+55 (${ddd}) ${num.slice(0, 5)}-${num.slice(5)}`\n    : `+55 (${ddd}) ${num.slice(0, 4)}-${num.slice(4)}`;\n}\n\nfunction extrairTexto(msg) {\n  switch (msg.type) {\n    case 'text': return msg.text?.body ?? '';\n    case 'button': return msg.button?.text ?? '';\n    case 'interactive':\n      return msg.interactive?.button_reply?.title ?? msg.interactive?.list_reply?.title ?? '';\n    case 'image': return '[imagem] ' + (msg.image?.caption ?? '');\n    case 'audio': return '[áudio]';\n    case 'video': return '[vídeo] ' + (msg.video?.caption ?? '');\n    case 'document': return '[documento] ' + (msg.document?.filename ?? '');\n    case 'location': return `[localização] ${msg.location?.latitude},${msg.location?.longitude}`;\n    case 'sticker': return '[figurinha]';\n    case 'reaction': return '[reação] ' + (msg.reaction?.emoji ?? '');\n    default: return `[${msg.type}]`;\n  }\n}\n\nconst dias = String(cfg.diasAtendimento).split(',').map(s => Number(s.trim()));\n\n$input.all().forEach((item, idx) => {\n  const j = item.json;\n  const value = j.messages ? j : (j.entry?.[0]?.changes?.[0]?.value ?? j);\n  const messages = value.messages ?? [];\n  const contacts = value.contacts ?? [];\n\n  for (const msg of messages) {\n    const contato = contacts.find(c => c.wa_id === msg.from) ?? contacts[0] ?? {};\n    const dt = DateTime.fromSeconds(Number(msg.timestamp)).setZone(cfg.fusoHorario);\n    const dentroHorario = dias.includes(dt.weekday)\n      && dt.hour >= Number(cfg.horaInicio) && dt.hour < Number(cfg.horaFim);\n\n    out.push({\n      json: {\n        messageId: msg.id,\n        whatsappId: String(msg.from),\n        telefone: formatarTelefone(msg.from),\n        nome: contato.profile?.name ?? 'Sem nome',\n        mensagem: extrairTexto(msg).trim(),\n        tipo: msg.type,\n        data: dt.toFormat('dd/MM/yyyy HH:mm'),\n        dentroHorario,\n        phoneNumberId: value.metadata?.phone_number_id ?? ''\n      },\n      pairedItem: { item: idx }\n    });\n  }\n});\n\nreturn out;"
      },
