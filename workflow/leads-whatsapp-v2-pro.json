    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Junta a mensagem nova com o que já existe na planilha e monta o pedido para a IA.\nconst lead = $('Extrair e normalizar').item.json;\nconst cfg = $('Configurações').first().json;\nconst linha = $json; // linha encontrada na aba Leads (vazia se o lead é novo)\nconst jaExiste = Boolean(linha['WhatsApp ID']);\n\nconst anterior = {\n  id: linha['ID'] ?? '',\n  qtd: Number(linha['Qtd mensagens'] || 0),\n  temperatura: String(linha['Temperatura'] ?? '').toLowerCase(),\n  resumo: linha['Resumo IA'] ?? '',\n  origem: linha['Origem'] ?? '',\n  score: linha['Score'] ?? '',\n  interesse: linha['Interesse'] ?? '',\n  proximoPasso: linha['Próximo passo'] ?? ''\n};\n\nconst system = `Você é o assistente comercial da empresa \"${cfg.nomeEmpresa}\". ${cfg.descricaoNegocio}\nAnalise a conversa de um lead que chegou pelo WhatsApp e responda APENAS com um JSON válido, sem nenhum texto fora dele, no formato:\n{\"temperatura\":\"quente|morno|frio\",\"score\":0,\"interesse\":\"\",\"resumo\":\"\",\"proximo_passo\":\"\",\"origem\":\"\"}\nRegras:\n- quente: quer comprar, pede preço, orçamento, horário ou agendamento.\n- morno: demonstra interesse, mas ainda está pesquisando ou tirando dúvidas.\n- frio: curiosidade, mensagem vaga, spam ou assunto fora do que a empresa vende.\n- score: 0 a 100, chance de virar venda.\n- interesse: produto ou serviço que a pessoa quer, em poucas palavras.\n- resumo: até 2 frases resumindo a conversa INTEIRA até agora (use o resumo anterior).\n- proximo_passo: ação concreta para o vendedor.\n- origem: de onde a pessoa disse que veio (Instagram, Google, indicação...) ou \"Não informado\".`;\n\nconst user = `Nome: ${lead.nome}\nResumo anterior: ${anterior.resumo || 'primeiro contato'}\nNova mensagem: ${lead.mensagem}`;\n\nreturn {\n  json: {\n    ...lead,\n    jaExiste,\n    anterior,\n    aiBody: {\n      model: cfg.modeloIA,\n      max_tokens: 400,\n      system,\n      messages: [{ role: 'user', content: user }]\n    }\n  }\n};"
      },
      "id": "b2f0c3e2-0009-4c1a-9b11-000000000009",
      "name": "Preparar análise IA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        620,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.aiBody) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "b2f0c3e2-0010-4c1a-9b11-000000000010",
      "name": "Qualificar com IA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        840,
        100
      ],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Lê a resposta da IA (com fallback se ela falhar) e monta a linha final do lead.\nconst base = $('Preparar análise IA').item.json;\nconst cfg = $('Configurações').first().json;\n\nlet ia = {};\ntry {\n  const txt = $json.content?.[0]?.text ?? '';\n  const m = txt.match(/\\{[\\s\\S]*\\}/);\n  ia = m ? JSON.parse(m[0]) : {};\n} catch (e) {\n  ia = {};\n}\n\nconst cap = s => s.charAt(0).toUpperCase() + s.slice(1);\nconst t = String(ia.temperatura ?? '').toLowerCase();\nconst temperaturaKey = ['quente', 'morno', 'frio'].includes(t) ? t : (base.anterior.temperatura || '');\nconst temperatura = temperaturaKey ? cap(temperaturaKey) : 'A classificar';\n\nconst origemIA = ia.origem && !/não informado/i.test(ia.origem) ? ia.origem : '';\nconst origem = origemIA || base.anterior.origem || 'WhatsApp';\n\nconst id = base.jaExiste && base.anterior.id\n  ? base.anterior.id\n  : 'LEAD-' + DateTime.now().setZone(cfg.fusoHorario).toFormat('yyMMddHHmmss');\n\n// Avisa o vendedor só quando o lead VIRA quente (evita spam a cada mensagem).\nconst notificarVendedor = temperaturaKey === 'quente'\n  && (!base.jaExiste || base.anterior.temperatura !== 'quente');\n\nconst primeiroNome = String(base.nome).split(' ')[0];\nlet respostaAutomatica = '';\nif (!base.jaExiste && cfg.respostaAutomatica) {\n  const modelo = base.dentroHorario ? cfg.msgBoasVindas : cfg.msgForaHorario;\n  respostaAutomatica = String(modelo).replace(/\\{nome\\}/g, primeiroNome);\n}\n\nreturn {\n  json: {\n    id,\n    whatsappId: base.whatsappId,\n    telefone: base.telefone,\n    nome: base.nome,\n    mensagem: base.mensagem,\n    data: base.data,\n    phoneNumberId: base.phoneNumberId,\n    jaExiste: base.jaExiste,\n    qtdMensagens: base.anterior.qtd + 1,\n    temperatura,\n    score: ia.score !== undefined && Number.isFinite(Number(ia.score)) ? Number(ia.score) : base.anterior.score,\n    interesse: ia.interesse || base.anterior.interesse,\n    resumo: ia.resumo || base.anterior.resumo,\n    proximoPasso: ia.proximo_passo || base.anterior.proximoPasso,\n    origem,\n    linkWhatsapp: `https://wa.me/${base.whatsappId}`,\n    iaFalhou: !$json.content,\n    notificarVendedor,\n    respostaAutomatica\n  }\n};"
      },
